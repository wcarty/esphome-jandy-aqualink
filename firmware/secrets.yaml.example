# Copy this file to firmware/secrets.yaml and fill in your own values.
# Never commit firmware/secrets.yaml to version control.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
ap_fallback_password: "CHANGE_ME_FALLBACK_PW"

# 32-byte base64 Noise encryption key (generate with `openssl rand -base64 32`)
pool_bridge_api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

pool_bridge_ota_password: "CHANGE_ME_OTA_PASSWORD"
pool_bridge_web_username: "admin"
pool_bridge_web_password: "CHANGE_ME_WEB_PASSWORD"
